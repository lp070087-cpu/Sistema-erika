# ---------------------------------------------------------------------------
# Érika Bruna — Gestão de Consultoria
# Copie este arquivo para `.env` e preencha. NUNCA versione o `.env`.
# ---------------------------------------------------------------------------

# Segredo usado para assinar a sessão de autenticação.
# Gere um valor novo com:  openssl rand -base64 32
AUTH_SECRET=

# URL pública do sistema. Em desenvolvimento: http://localhost:3000
AUTH_URL=http://localhost:3000

# Banco de dados (Neon). Ainda NÃO configurado nesta fase.
# A conexão com pool é usada pela aplicação:
DATABASE_URL=
# A conexão direta é usada pelas migrations do Prisma:
DIRECT_URL=

# ---------------------------------------------------------------------------
# Credenciais de acesso da consultora (usuário único nesta fase).
# Gere o hash com:  npm run senha:hash -- "sua-senha"
# NUNCA coloque a senha em texto puro aqui — somente o hash.
# ---------------------------------------------------------------------------
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
